{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "packageName": "ai.knowall.thyme",
  "name": {
    "short": "Thyme",
    "full": "Thyme - Timesheet Reminders"
  },
  "description": {
    "short": "Daily timesheet reminders",
    "full": "Thyme reminds you to fill in your timesheet at 5pm each day. Never miss logging your hours again! Features include daily reminders at your preferred time, quick status checks, and direct links to your timesheet."
  },
  "developer": {
    "name": "KnowAll AI",
    "websiteUrl": "https://knowall.ai",
    "privacyUrl": "https://knowall.ai/privacy",
    "termsOfUseUrl": "https://knowall.ai/terms"
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#2E7D32",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "help",
              "description": "Show available commands"
            },
            {
              "title": "subscribe",
              "description": "Get daily reminders at 5pm"
            },
            {
              "title": "unsubscribe",
              "description": "Stop receiving reminders"
            },
            {
              "title": "status",
              "description": "Show today's logged hours"
            }
          ]
        }
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "timesheet",
      "name": "Timesheet",
      "contentUrl": "https://thyme.knowall.ai/timesheet?context=teams",
      "websiteUrl": "https://thyme.knowall.ai/timesheet",
      "scopes": ["personal"]
    },
    {
      "entityId": "timer",
      "name": "Timer",
      "contentUrl": "https://thyme.knowall.ai/timer?context=teams",
      "websiteUrl": "https://thyme.knowall.ai/timer",
      "scopes": ["personal"]
    },
    {
      "entityId": "reports",
      "name": "Reports",
      "contentUrl": "https://thyme.knowall.ai/reports?context=teams",
      "websiteUrl": "https://thyme.knowall.ai/reports",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["thyme.knowall.ai", "${{BOT_DOMAIN}}"]
}
