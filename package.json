{
  "name": "thyme-bot",
  "version": "1.0.0",
  "description": "Microsoft Teams bot for timesheet reminders - Thyme by KnowAll AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "teams",
    "bot",
    "timesheet",
    "reminder",
    "thyme",
    "knowall"
  ],
  "author": "KnowAll AI",
  "license": "MIT",
  "dependencies": {
    "@azure/data-tables": "^13.2.2",
    "@microsoft/adaptivecards-tools": "^1.0.0",
    "adaptivecards": "^3.0.4",
    "botbuilder": "^4.22.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "luxon": "^3.4.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/luxon": "^3.3.7",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "env-cmd": "^10.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
